{
  "name": "@openagents/overlord",
  "version": "0.1.0",
  "description": "Overlord/overseer login + privilege hierarchy. Public vs privileged, levels from on-chain holdings whose blockchain tenure is chronos-verified, identity by signature (ECDSA + ERC-1271). Pure viem; no rainbowkit/wagmi.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./view": {
      "types": "./dist/view/OverlordLogin.d.ts",
      "default": "./dist/view/OverlordLogin.js"
    }
  },
  "files": [
    "dist",
    "src",
    "view"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "viem": "^2.21.0"
  },
  "peerDependencies": {
    "@openagents/wallet": ">=0.1.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@openagents/wallet": { "optional": true },
    "react": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}

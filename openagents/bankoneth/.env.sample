# bankoneth — environment sample. Copy to .env (gitignored) and fill.
# Secrets should live in the bankon-vault (vault_module/) in production; .env is for local dev.

# ── RPC endpoints (forge [rpc_endpoints] + the gate backend tier reads) ──────
MAINNET_RPC=https://ethereum-rpc.publicnode.com
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
BASE_RPC=https://base-rpc.publicnode.com
ZEROG_RPC=https://evmrpc-testnet.0g.ai
# ARC (Circle USDC-gas chain) — testnet first; fill once you have endpoints.
ARC_RPC_URL=

# ── Etherscan V2 (ONE key, all chains via api.etherscan.io/v2/api?chainid=) ──
# Used by `forge verify-contract`, script/Verify.s.sol, and script/etherscan_lookup.mjs.
# Never commit a real key. See docs/ETHERSCAN.md.
ETHERSCAN_API_KEY=

# ── Deploy / role-grant (Phase 0) ───────────────────────────────────────────
DEPLOYER_PK=
TREASURY_ADDR=
# bankon.eth owner — the page-admin. Observed via NameWrapper.ownerOf(node).
# GrantOwnerRoles.s.sol grants this address GOV_ROLE / router-admin / hosting-admin.
BANKON_OWNER_ADDR=0x54165AdA93FA752cfec95F3f3bAE2676D3752A99

# ── Gate backend (Phase 2) + bankon-vault / shadow-overlord (Phase 1) ────────
# The wallet whose signature unlocks admin (shadow-overlord). For bankon, this is
# typically the bankon.eth owner; the gate ALSO verifies on-chain ownership live.
SHADOW_OVERLORD_ADDRESS=0x54165AdA93FA752cfec95F3f3bAE2676D3752A99
SHADOW_JWT_SECRET=            # >=32 chars
BANKON_VAULT_DIR=            # default: vault_module/data/vault
BANKON_GATE_RPC=             # default: MAINNET_RPC (tier resolution reads ENS NameWrapper)

# bankonchains — CoinMarketCap proxy config TEMPLATE.
#
# ⚠️  Do NOT put the real key in a file under packages/web/ — a static host would SERVE it.
# Put the real values OUTSIDE the web root, in the bankoneth-root file `.bankonchains.env`
# (gitignored), or export them as environment variables. The proxies load from there.
#   cp packages/web/bankonchains/.env.sample <bankoneth>/.bankonchains.env   # then edit
# The CMC key is SERVER-SIDE ONLY (cmc-proxy.mjs / cmc-proxy.php), never shipped to the
# browser or committed. Public visitors use the keyless price path (price.js).

# CoinMarketCap Pro API key — Basic plan: 30 req/min, 10,000 calls/month (hard cap).
CMC_API_KEY=

# Symbols batched into ONE quotes/latest call (credit-optimal; cached ≥120s).
CMC_SYMBOLS=ETH,POL,GLMR,INJ,USDC,USDT

# Optional operator allowlist of holder addresses (comma-separated), in addition to the
# on-chain bankon.eth / *.bankon.eth check the Node proxy performs.
CMC_HOLDERS=

# Node proxy port.
CMC_PROXY_PORT=8799

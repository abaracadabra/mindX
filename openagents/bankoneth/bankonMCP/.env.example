# bankonMCP — copy to .env (gitignored). The payer key is server-side only; never commit it.

# x402 payer wallet (must hold USDC on the rails you'll pay on: Base / Arc / …).
EVM_PRIVATE_KEY=

# Remote MCP servers (or use x402-mcps.json / X402_CONFIG).
# X402_REMOTE_MCPS=[{"name":"cmc","url":"https://pro-api.coinmarketcap.com/mcp"}]
X402_CONFIG=./x402-mcps.json

# AgenticPlace payment-processor report endpoint (settlements + φ fee accounting). Optional.
AGENTICPLACE_URL=https://agenticplace.pythai.net

# Rail policy caps (6dp USDC) — defaults in rails.ts if unset.
# X402_MAX_PER_CALL_USDC=1000000
# X402_SESSION_BUDGET_USDC=50000000

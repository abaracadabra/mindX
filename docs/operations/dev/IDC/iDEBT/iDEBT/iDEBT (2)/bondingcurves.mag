Use Case:
Useful in projects that want to attract early adopters with low prices but ensure that the token price stabilizes as more are minted.
Conclusion: Choosing the Right Bonding Curve

When deciding which bonding curve to use for your project, it’s essential to consider the project’s goals, the behavior you want to incentivize, and the stage of your project’s lifecycle. For example:

Early Growth: Exponential, logarithmic, or sigmoid curves work well if you want to reward early adopters.
Long-Term Sustainability: Linear, hyperbolic, or step functions can provide stable, predictable growth over time.
Dynamic Pricing: Hybrid or mixed curves allow flexibility across different phases of your token sale or project lifecycle.

Each bonding curve model has its advantages, and you may even want to combine multiple models for different stages of your project. Bonding curves can be a powerful tool in decentralized finance, token sales, and governance systems, allowing you to balance incentives, price discovery, and liquidity.

Create a code example for each type of bonding curve.

Here are code examples for various bonding curves based on the different mathematical models we discussed. Each contract allows buying DAIO tokens using ETH, with the price determined by a specific bonding curve formula.

1. Linear Bonding Curve

The price increases linearly as more DAIO tokens are minted.

// SPDX-License-Identifier: MIT
pragma solidity ^0.8.0;

contract LinearBondingCurve {
    uint256 public totalSupply;
    uint256 public reserveBalance;
    uint256 public constant slope = 1e18;  // Linear slope
    uint256 public constant intercept = 1e18;  // Starting price

    mapping(address => uint256) public balanceOf;

    event Buy(address indexed buyer, uint256 amount, uint256 cost);

    // Linear price curve: P(x) = intercept + slope * totalSupply
    function priceToMint(uint256 _amount) public view returns (uint256) {
        return intercept + slope * totalSupply;
    }

    // Buy DAIO tokens using ETH
    function buy() public payable {
        uint256 tokenAmount = msg.value / priceToMint(1);
        totalSupply += tokenAmount;
        reserveBalance += msg.value;
        balanceOf[msg.sender] += tokenAmount;

        emit Buy(msg.sender, tokenAmount, msg.value);
    }

    // Withdraw accumulated ETH (reserve balance)
    function withdraw() external {
        uint256 amount = reserveBalance;
        reserveBalance = 0;
        payable(msg.sender).transfer(amount);
    }
}
2. Exponential Bonding Curve

The price increases exponentially as the token supply grows.

// SPDX-License-Identifier: MIT
pragma solidity ^0.8.0;

contract ExponentialBondingCurve {
    uint256 public totalSupply;
    uint256 public reserveBalance;
    uint256 public constant initialPrice = 1e18;  // Starting price
    uint256 public constant growthRate = 2e18;  // Exponential growth rate

    mapping(address => uint256) public balanceOf;

    event Buy(address indexed buyer, uint256 amount, uint256 cost);

    // Exponential price curve: P(x) = initialPrice * exp(growthRate * totalSupply)
    function priceToMint(uint256 _amount) public view returns (uint256) {
        return initialPrice * exp(growthRate * totalSupply);
    }

    // Simplified exponential function approximation
    function exp(uint256 x) internal pure returns (uint256) {
        return (2.71828**x);  // Simplified exponential function
    }

    // Buy DAIO tokens using ETH
    function buy() public payable {
        uint256 tokenAmount = msg.value / priceToMint(1);
        totalSupply += tokenAmount;
        reserveBalance += msg.value;
        balanceOf[msg.sender] += tokenAmount;

        emit Buy(msg.sender, tokenAmount, msg.value);
    }

    // Withdraw accumulated ETH
    function withdraw() external {
        uint256 amount = reserveBalance;
        reserveBalance = 0;
        payable(msg.sender).transfer(amount);
    }
}
3. Logarithmic Bonding Curve

The price rises sharply at the beginning but then levels off as the supply increases.

// SPDX-License-Identifier: MIT
pragma solidity ^0.8.0;

contract LogarithmicBondingCurve {
    uint256 public totalSupply;
    uint256 public reserveBalance;
    uint256 public constant basePrice = 1e18;  // Starting price
    uint256 public constant multiplier = 1e18;  // Logarithmic multiplier

    mapping(address => uint256) public balanceOf;

    event Buy(address indexed buyer, uint256 amount, uint256 cost);

    // Logarithmic price curve: P(x) = basePrice * ln(multiplier * totalSupply)
    function priceToMint(uint256 _amount) public view returns (uint256) {
        return basePrice * ln(multiplier * totalSupply);
    }

    // Logarithmic approximation
    function ln(uint256 x) internal pure returns (uint256) {
        require(x > 0, "Logarithm undefined for non-positive values");
        return uint256((2.302585 * log10(x)));  // Using log10 as a simple approximation
    }

    // Buy DAIO tokens using ETH
    function buy() public payable {
        uint256 tokenAmount = msg.value / priceToMint(1);
        totalSupply += tokenAmount;
        reserveBalance += msg.value;
        balanceOf[msg.sender] += tokenAmount;

        emit Buy(msg.sender, tokenAmount, msg.value);
    }

    // Withdraw accumulated ETH
    function withdraw() external {
        uint256 amount = reserveBalance;
        reserveBalance = 0;
        payable(msg.sender).transfer(amount);
    }
}
4. Sigmoid Bonding Curve

The price increases slowly at first, then rises rapidly before tapering off.

// SPDX-License-Identifier: MIT
pragma solidity ^0.8.0;

contract SigmoidBondingCurve {
    uint256 public totalSupply;
    uint256 public reserveBalance;
    uint256 public constant cap = 10e18;  // Maximum price
    uint256 public constant steepness = 2e18;  // Steepness of the curve
    uint256 public constant inflectionPoint = 5e18;  // Inflection point

    mapping(address => uint256) public balanceOf;

    event Buy(address indexed buyer, uint256 amount, uint256 cost);

    // Sigmoid price curve: P(x) = cap / (1 + e^(-steepness * (totalSupply - inflectionPoint)))
    function priceToMint(uint256 _amount) public view returns (uint256) {
        return cap / (1 + exp(-steepness * (totalSupply - inflectionPoint)));
    }

    // Approximate the exponential function (sigmoid formula)
    function exp(uint256 x) internal pure returns (uint256) {
        return (2.71828**x);  // Simplified exponential approximation
    }

    // Buy DAIO tokens with ETH
    function buy() public payable {
        uint256 tokenAmount = msg.value / priceToMint(1);
        totalSupply += tokenAmount;
        reserveBalance += msg.value;
        balanceOf[msg.sender] += tokenAmount;

        emit Buy(msg.sender, tokenAmount, msg.value);
    }

    // Withdraw accumulated ETH
    function withdraw() external {
        uint256 amount = reserveBalance;
        reserveBalance = 0;
        payable(msg.sender).transfer(amount);
    }
}
5. Polynomial Bonding Curve

A polynomial curve allows the price to increase more smoothly but faster than linear growth.

// SPDX-License-Identifier: MIT
pragma solidity ^0.8.0;

contract PolynomialBondingCurve {
    uint256 public totalSupply;
    uint256 public reserveBalance;

    mapping(address => uint256) public balanceOf;

    event Buy(address indexed buyer, uint256 amount, uint256 cost);

    // Polynomial price curve: P(x) = ax^2 + bx + c (quadratic example)
    function priceToMint(uint256 _amount) public view returns (uint256) {
        return (1e18 * totalSupply ** 2) + (1e18 * totalSupply) + 1e18;
    }

    // Buy DAIO tokens with ETH
    function buy() public payable {
        uint256 tokenAmount = msg.value / priceToMint(1);
        totalSupply += tokenAmount;
        reserveBalance += msg.value;
        balanceOf[msg.sender] += tokenAmount;

        emit Buy(msg.sender, tokenAmount, msg.value);
    }

    // Withdraw accumulated ETH
    function withdraw() external {
        uint256 amount = reserveBalance;
        reserveBalance = 0;
        payable(msg.sender).transfer(amount);
    }
}
6. Step Function Bonding Curve

The price remains constant within certain supply intervals and jumps to a higher level after each interval.

// SPDX-License-Identifier: MIT
pragma solidity ^0.8.0;

contract StepFunctionBondingCurve {
    uint256 public totalSupply;
    uint256 public reserveBalance;
    uint256 public constant stepSize = 100;  // Number of tokens in each step
    uint256 public constant priceStep = 1e18;  // Price increase for each step

    mapping(address => uint256) public balanceOf;

    event Buy(address indexed buyer, uint256 amount, uint256 cost);

    // Step function: price remains constant for each interval of `stepSize`
    function priceToMint(uint256 _amount) public view returns (uint256) {
        uint256 step = totalSupply / stepSize;
        return (step + 1) * priceStep;
    }

    // Buy DAIO tokens with ETH
    function buy() public payable {
        uint256 tokenAmount = msg.value / priceToMint(1);
        totalSupply += tokenAmount;
        reserveBalance += msg.value;
        balanceOf[msg.sender] += tokenAmount;

        emit Buy(msg.sender, tokenAmount, msg.value);
    }

    // Withdraw accumulated ETH
    function withdraw() external {
        uint256 amount = reserveBalance;
        reserveBalance = 0;
        payable(msg.sender).transfer(amount);
    }
}
7. Hyperbolic Bonding Curve

The price increases quickly at first and then slows down as supply grows.


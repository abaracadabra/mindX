## MEMORY & LONG-RUNNING TASKS

### Persistent Memory System

```python
# DeltaVerse Memory System
class MemorySystem:
    """
    Persistent memory across agent sessions
    """
    
    def __init__(self, memory_dir='/memories'):
        self.memory_dir = Path(memory_dir)
        self.memory_dir.mkdir(exist_ok=True)
        
        # Memory categories
        self.progress = MemoryCategory(self.memory_dir / 'progress')
        self.decisions = MemoryCategory(self.memory_dir / 'decisions')
        self.learnings = MemoryCategory(self.memory_dir / 'learnings')
        self.context = MemoryCategory(self.memory_dir / 'context')
        self.preferences = MemoryCategory(self.memory_dir / 'preferences')
    
    def before_session(self):
        """
        Called before each agent session starts
        """
        # Load relevant memories
        recent_progress = self.progress.get_recent(days=7)
        key_decisions = self.decisions.get_all()
        user_prefs = self.preferences.get_all()
        
        return {
            'progress': recent_progress,
            'decisions': key_decisions,
            'preferences': user_prefs,
            'last_session': self.get_last_session_summary()
        }
    
    def after_session(self, session_data):
        """
        Called after each agent session completes
        """
        # Log what was accomplished
        self.progress.append({
            'timestamp': datetime.now(),
            'tasks_completed': session_data.tasks,
            'files_modified': session_data.files,
            'commits': session_data.commits,
            'issues_closed': session_data.issues
        })
        
        # Store important decisions
        for decision in session_data.decisions:
            self.decisions.add(decision)
        
        # Capture learnings
        for learning in session_data.learnings:
            self.learnings.add(learning)
    
    def recall_related(self, mission):
        """
        Retrieve memories related to current mission
        """
        # Semantic search across all memory categories
        related_progress = self.progress.search(mission.keywords)
        related_decisions = self.decisions.search(mission.keywords)
        related_learnings = self.learnings.search(mission.keywords)
        
        return {
            'progress': related_progress,
            'decisions': related_decisions,
            'learnings': related_learnings
        }

class MemoryCategory:
    """Individual memory category storage"""
    
    def __init__(self, path):
        self.path = Path(path)
        self.path.mkdir(exist_ok=True)
    
    def append(self, entry):
        """Append new memory entry"""
        timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')
        filepath = self.path / f"{timestamp}.json"
        
        with open(filepath, 'w') as f:
            json.dump(entry, f, indent=2, default=str)
    
    def get_recent(self, days=7):
        """Get memories from last N days"""
        cutoff = datetime.now() - timedelta(days=days)
        recent = []
        
        for filepath in self.path.glob('*.json'):
            timestamp = datetime.strptime(filepath.stem, '%Y%m%d_%H%M%S')
            if timestamp >= cutoff:
                with open(filepath) as f:
                    recent.append(json.load(f))
        
        return sorted(recent, key=lambda x: x['timestamp'], reverse=True)
    
    def search(self, keywords):
        """Semantic search across memories"""
        # Load all memories
        all_memories = []
        for filepath in self.path.glob('*.json'):
            with open(filepath) as f:
                all_memories.append(json.load(f))
        
        # Embed and search
        embeddings = embed_texts([json.dumps(m) for m in all_memories])
        query_embedding = embed_text(' '.join(keywords))
        
        # Cosine similarity
        similarities = cosine_similarity([query_embedding], embeddings)[0]
        
        # Return top matches
        top_indices = np.argsort(similarities)[-5:][::-1]
        return [all_memories[i] for i in top_indices]
```

